# --- MQTT (EMQX Cloud) ---
# Required. Broker URL, e.g. mqtts://xxxxx.emqxsl.com:8883
MQTT_URL=
# Required.
MQTT_USERNAME=
# Required.
MQTT_PASSWORD=
# Stable client id so the broker can resume the session.
MQTT_CLIENT_ID=impact-telemetry-01
# Topic filter to subscribe to.
MQTT_TOPIC_FILTER=hospitals/#

# --- TimescaleDB (Tiger Cloud) ---
# Whether to write the time-series provenance copy at all. true | false.
# Defaults to TRUE: disabling the provenance store must be a deliberate act,
# never the side effect of a dropped or typo'd TIMESCALE_URL. When true, a
# missing URL is a fatal config error and an unreachable server is a fatal
# startup error; when false, TIMESCALE_URL is not read, parsed or connected.
TIMESCALE_ENABLED=true
# Required WHEN TIMESCALE_ENABLED=true. Postgres connection string,
# e.g. postgres://user:pass@host:5432/db?sslmode=require
TIMESCALE_URL=
# Path to Tiger Cloud's CA certificate (PEM) used to verify the TLS chain.
# Capture it once with the openssl s_client STARTTLS chain dump; checked into certs/.
TIMESCALE_CA_PATH=certs/timescale-ca.pem

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Numeric batching ---
# Flush the numeric insert buffer at least this often (ms).
NUMERIC_BATCH_INTERVAL_MS=100
# Flush the numeric insert buffer once it reaches this many rows.
NUMERIC_BATCH_MAX_SIZE=500

# --- WebSocket broadcast ---
WS_PORT=8080
# Required. Shared secret clients must present to connect.
WS_SHARED_SECRET=

# --- IMPACT API (clinical backend) ---
# Required. Base URL of the IMPACT API server. For local testing:
# http://localhost:3035. For staging:
# https://ci-dev-api.speedum.tech (or wherever staging lives).
IMPACT_API_URL=
# Required. Hospital identifier sent as the X-Hospital-ID header on every
# ingest POST. Must match the IMPACT-side site_id for this hospital.
IMPACT_HOSPITAL_ID=
# Required. Shared secret sent as X-Ingest-Key. Must match one of the
# values accepted by the IMPACT ingest endpoint.
IMPACT_INGEST_KEY=
# Ingest mode: dry-run logs what would be sent without POSTing; live posts for real.
IMPACT_INGEST_MODE=dry-run
# HTTP request timeout for IMPACT ingest calls (ms).
IMPACT_HTTP_TIMEOUT_MS=5000

# --- DEMO SHIM: simulator schema 2.0 (see src/mqtt/schema2-shim.ts) ---
# The BCCH simulator publishes schema_version 2.0: 7-segment topics, short
# metric ids (HR/RR/SPO2/TEMP/FIO2) and non-BCCH identifiers. This flag accepts
# those by normalising them to the 1.0 contract, translating identity ONLY via
# an explicit allowlist (an unknown device is refused, never relabelled).
# Off by default — it is a shim, not architecture, and is expected to be removed
# once Arman/Hans confirm what the real gateway emits. A 2.0 topic arriving
# while this is off is warned about, never silently dropped.
SCHEMA2_SHIM_ENABLED=false
