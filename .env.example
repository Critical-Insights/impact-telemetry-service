# --- MQTT (EMQX Cloud) ---
# Required. Broker URL, e.g. mqtts://xxxxx.emqxsl.com:8883
MQTT_URL=
# Required.
MQTT_USERNAME=
# Required.
MQTT_PASSWORD=
# Stable client id so the broker can resume the session.
MQTT_CLIENT_ID=impact-telemetry-01
# Topic filter to subscribe to.
MQTT_TOPIC_FILTER=hospitals/#

# --- TimescaleDB (Tiger Cloud) ---
# Required. Postgres connection string, e.g. postgres://user:pass@host:5432/db?sslmode=require
TIMESCALE_URL=
# Path to Tiger Cloud's CA certificate (PEM) used to verify the TLS chain.
# Capture it once with the openssl s_client STARTTLS chain dump; checked into certs/.
TIMESCALE_CA_PATH=certs/timescale-ca.pem

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Numeric batching ---
# Flush the numeric insert buffer at least this often (ms).
NUMERIC_BATCH_INTERVAL_MS=100
# Flush the numeric insert buffer once it reaches this many rows.
NUMERIC_BATCH_MAX_SIZE=500

# --- WebSocket broadcast ---
WS_PORT=8080
# Required. Shared secret clients must present to connect.
WS_SHARED_SECRET=

# --- IMPACT API (clinical backend) ---
# Required. Base URL of the IMPACT API server. For local testing:
# http://localhost:3035. For staging:
# https://ci-dev-api.speedum.tech (or wherever staging lives).
IMPACT_API_URL=
# Required. Hospital identifier sent as the X-Hospital-ID header on every
# ingest POST. Must match the IMPACT-side site_id for this hospital.
IMPACT_HOSPITAL_ID=
# Required. Shared secret sent as X-Ingest-Key. Must match one of the
# values accepted by the IMPACT ingest endpoint.
IMPACT_INGEST_KEY=
# Ingest mode: dry-run logs what would be sent without POSTing; live posts for real.
IMPACT_INGEST_MODE=dry-run
# HTTP request timeout for IMPACT ingest calls (ms).
IMPACT_HTTP_TIMEOUT_MS=5000
