# THR (Texas Health Resources) — telemetry service, LOCAL LAPTOP run.
#
# Copy to `.env.thr` and fill the four PLACEHOLDER values marked "<<< NEEDED".
# Nothing here is a real value and nothing here may become one in git:
# `.env.thr` is gitignored, this template is not.
#
#   cp .env.thr.example .env.thr
#   $EDITOR .env.thr          # fill the <<< NEEDED lines
#   npm run dev:thr
#
# Why a separate file rather than `.env`: one repo serves both hospitals, and
# `.env` already holds the BCCH configuration. `npm run dev:thr` sets
# DOTENV_CONFIG_PATH so this file is read INSTEAD, leaving BCCH's untouched.
#
# Every variable src/config.ts reads is listed, including the ones that only
# have defaults — a config file you have to cross-reference against source is
# how a wrong default survives to production.

# ─────────────────────────────────────────────────────────────────────────────
# MQTT — the THR broker. SEPARATE from BCCH's.
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. <<< NEEDED FROM DHRUV. e.g. mqtts://<thr-broker-host>:8883
MQTT_URL=mqtts://REPLACE-ME.example.invalid:8883
# REQUIRED. <<< NEEDED FROM DHRUV. Must carry an ACL permitting SUBSCRIBE on
# the THR topic root below; a subscribe-only credential scoped to the wrong
# prefix answers `Not authorized` and nothing arrives.
MQTT_USERNAME=REPLACE-ME
# REQUIRED. <<< NEEDED FROM DHRUV. Secret. Keep this file at 0600.
MQTT_PASSWORD=REPLACE-ME

# THR-specific, and it must stay unique PER RUNNING INSTANCE on this broker.
# The service connects with clean:false to keep its QoS-1 queue across
# reconnects, so two processes sharing an id make the broker hand the session
# back and forth (MQTT 5 reason code 142) and BOTH lose batches, silently.
# If you start a second copy to test something, change this first.
MQTT_CLIENT_ID=impact-telemetry-thr-01

# THR topic root.
#
# ⚠️ CONFIRM THIS AGAINST WHAT THE THR PUBLISHER ACTUALLY SENDS. A filter that
# matches nothing is not a silent failure here — /health reports `down` with
# "no device has published" once the grace window expires — but it will cost
# you the first twenty minutes of a bring-up. For reference, the BCCH simulator
# publishes under `hospitals/example-hospital/...`, NOT under its own hospital
# id, so do not assume the first segment is the tenant.
# If in doubt on a dedicated THR broker, widen this to `hospitals/#`.
MQTT_TOPIC_FILTER=hospitals/thr/#

# ─────────────────────────────────────────────────────────────────────────────
# IMPACT API — the clinical backend. Local server on this laptop.
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. The IMPACT server running locally. Start it BEFORE this service.
IMPACT_API_URL=http://localhost:3035

# REQUIRED. Sent as the `X-Hospital-ID` header on every ingest POST and it must
# equal the IMPACT-side site_id for THR.
#
# ⚠️ THIS IS THE TENANCY FIELD. A wrong value here does not fail — it writes
# THR readings under another hospital, and the rows are indistinguishable from
# that hospital's real ones afterwards. Check it against the server, twice.
IMPACT_HOSPITAL_ID=thr

# REQUIRED. <<< NEEDED FROM DHRUV. Secret, sent as `X-Ingest-Key`. Must match a
# value the local IMPACT ingest endpoint accepts.
IMPACT_INGEST_KEY=REPLACE-ME

# dry-run | live.
#
# DRY-RUN IS NOT A NO-OP, and that is what makes it useful: it short-circuits
# at the POST only. Patient resolution still happens first, so a dry-run
# instance proves the whole chain — broker -> topic -> device id -> trinity
# code -> patient — against the real API while writing nothing.
#
# Consequence: IMPACT_API_URL, IMPACT_INGEST_KEY and IMPACT_HOSPITAL_ID must
# all be REAL AND CORRECT even in dry-run.
#
# Leave this at dry-run. Flipping it to `live` is Dhruv's explicit decision.
IMPACT_INGEST_MODE=dry-run

# HTTP request timeout for IMPACT calls (ms).
IMPACT_HTTP_TIMEOUT_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# Ingest loudness. Defaults are fine for a laptop bring-up.
# ─────────────────────────────────────────────────────────────────────────────
# A device attempting this long without landing a reading is escalated to
# error. 60s at 1 Hz is 60 missed readings.
IMPACT_UNHEALTHY_AFTER_MS=60000
# How often a still-stalled device restates its error.
IMPACT_ESCALATE_EVERY_MS=60000
# Whole-feed summary interval, so silence can be told from a crash.
IMPACT_HEARTBEAT_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# Schema 2.0 shim
# ─────────────────────────────────────────────────────────────────────────────
# Set true ONLY if the THR publisher emits 7-segment topics with short metric
# ids (HR/RR/SPO2/TEMP/FIO2). If it does and this is false, those messages are
# WARNED about and dropped — never silently discarded, but also never ingested.
#
# ⚠️ Turning this on is not sufficient by itself: the shim translates a
# published device id to a trinity_code through a HARDCODED allowlist in
# src/mqtt/schema2-shim.ts. THR devices are not in it yet. That is a code
# change on this branch, not a config change and not a database row.
SCHEMA2_SHIM_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Health endpoint
# ─────────────────────────────────────────────────────────────────────────────
HEALTH_ENABLED=true
# 3036. Deliberately not 3035 — that is the IMPACT server.
HEALTH_PORT=3036
# Loopback, correct for a laptop. The response body carries device and bed
# identifiers; widen this only for an off-box scraper, which a laptop is not.
HEALTH_BIND=127.0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# TimescaleDB — OFF for this run.
# ─────────────────────────────────────────────────────────────────────────────
# The time-series provenance copy, not the clinical path. Off means
# TIMESCALE_URL is not read, parsed or connected, and the two variables below
# are ignored. Leave it off unless someone asks for provenance.
TIMESCALE_ENABLED=false
# Required ONLY when TIMESCALE_ENABLED=true (startup fails naming this var).
TIMESCALE_URL=
TIMESCALE_CA_PATH=certs/timescale-ca.pem

# Numeric insert batching — Timescale-only, ignored while it is off.
NUMERIC_BATCH_INTERVAL_MS=100
NUMERIC_BATCH_MAX_SIZE=500

# ─────────────────────────────────────────────────────────────────────────────
# WebSocket broadcast — DEAD CONFIG.
# ─────────────────────────────────────────────────────────────────────────────
# WS_SHARED_SECRET is REQUIRED by config validation but is read nowhere in
# src/ — the service will not start without it and will never use it. The
# placeholder below is sufficient. Do NOT procure a real secret for this, and
# do not expose the port. Both variables should be deleted from the schema.
WS_PORT=8080
WS_SHARED_SECRET=unused-placeholder

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
